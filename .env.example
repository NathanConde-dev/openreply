# =============================================================================
# CONFIGURAÇÃO BÁSICA
# =============================================================================

# URL pública do aplicativo (onde ele será acessado)
# Ex.: https://seudominio.com ou http://localhost:3000 para desenvolvimento
NEXTAUTH_URL=http://localhost:3000

# Segredo para sessões de autenticação (32+ caracteres aleatórios)
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=substitua-por-um-segredo-forte-e-aleatorio

# Segredo para proteger endpoints de cron (pode ser o mesmo do NEXTAUTH_SECRET)
# Usado em /api/cron/* para garantir que apenas jobs internos acessem
CRON_SECRET=substitua-por-um-segredo-forte-e-aleatorio

# Chave de criptografia para tokens do Instagram (exatamente 64 caracteres hex)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =============================================================================
# BANCO DE DADOS E FILA
# =============================================================================

# URL de conexão do PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply

# URL de conexão do Redis
# Formato: redis://host:porta ou redis://:senha@host:porta
REDIS_URL=redis://localhost:6379

# =============================================================================
# E-MAIL (Magic Links para login)
# =============================================================================

# OPÇÃO 1: Resend (recomendado para quem está começando)
# Crie uma conta gratuita em https://resend.com e pegue sua API key
RESEND_API_KEY=re_...
EMAIL_FROM=Seu App <login@seudominio.com>

# OPÇÃO 2: Servidor SMTP próprio (Gmail, SendGrid, etc.)
# Se definir EMAIL_SERVER, o Resend não será usado
# Atenção: codifique caracteres especiais na URL (@ vira %40)
# Ex. Gmail: smtps://seuemail%40gmail.com:suasenha@smtp.gmail.com:465
# EMAIL_SERVER=smtps://login%40example.com:senha@smtp.seudominio.com:465
# EMAIL_FROM=Seu App <login@seudominio.com>

# =============================================================================
# CONTROLE DE ACESSO
# =============================================================================

# OBRIGATÓRIO EM PRODUÇÃO: e-mails permitidos para login (separados por vírgula)
# Sem esta variável, qualquer pessoa pode criar conta no seu app
# Ex.: seuemail@gmail.com,parceiro@empresa.com
ALLOWED_EMAILS=seuemail@gmail.com

# =============================================================================
# INSTAGRAM / META API
# =============================================================================

# Versão da API do Meta Graph (geralmente não precisa mudar)
META_GRAPH_API_VERSION=v25.0

# Credenciais do seu app no Meta/Facebook
# Pegue em: https://developers.facebook.com/apps
INSTAGRAM_APP_ID=seu-app-id-do-instagram
INSTAGRAM_APP_SECRET=seu-app-secret-do-instagram
FACEBOOK_APP_SECRET=seu-app-secret-do-facebook

# Token de verificação do webhook (você define este valor)
# Use o MESMO valor ao configurar webhooks no Meta App Dashboard
# Pode ser qualquer string aleatória (ex.: openssl rand -base64 32)
WEBHOOK_VERIFY_TOKEN=seu-token-de-verificacao-de-webhook

# =============================================================================
# OPCIONAIS
# =============================================================================

# Intervalo do polling de comentários em ms (padrão: 5 minutos)
# COMMENT_POLL_INTERVAL_MS=300000

# Número mínimo de jobs na fila para considerar o worker travado (padrão: 25)
# HEALTH_STUCK_QUEUE_WAITING=25

# Atrasos para re-verificar follow em ms, separados por vírgula (padrão: 20s, 40s)
# FOLLOW_RECHECK_DELAYS_MS=20000,40000

# Mensagem de reconhecimento ao re-verificar follow (opcional)
# FOLLOW_RECHECK_ACK_MESSAGE=Verificando seu follow, só um momento...

# Ambiente Node.js (production ou development)
# NODE_ENV=production
